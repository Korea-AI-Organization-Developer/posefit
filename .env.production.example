# PoseFit 배포용 환경변수 템플릿
# 사용법:  cp .env.production.example .env  후 값 채우기 → docker compose up -d --build
#
# 팀 할당 포트 13000~13999 / Cafe24 리눅스 서버 기준.

# ─── MySQL (db 컨테이너) ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=posefitdb
MYSQL_USER=posefit
MYSQL_PASSWORD=change-me-password

# ─── 백엔드 ────────────────────────────────────────────────────────────
# host 는 compose 네트워크 내부 서비스명 'db'. (호스트에서 직접 붙을 땐 127.0.0.1:13306)
# MYSQL_USER:MYSQL_PASSWORD 와 일치시킬 것.
DATABASE_URL=mysql+aiomysql://posefit:change-me-password@db:3306/posefitdb

# JWT 서명 키 — 반드시 충분히 긴 랜덤 값으로 교체 (예: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Google OAuth (콜백 코드 교환용)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM (리포트 종합평가) — 비우면 규칙 기반 폴백
GOOGLE_API_KEY=
GEMINI_API_KEY=

# CORS 허용 origin (콤마 구분). 공개 도메인/포트로 접근 시 추가.
CORS_ORIGINS=http://localhost:13000,http://localhost:13001

# ─── 프론트엔드 / 관리자 (빌드 ARG + 런타임) ─────────────────────────────
# 서버사이드(BFF) 호출이라 내부 서비스명 사용. 브라우저는 backend 를 직접 부르지 않음.
NEXT_PUBLIC_API_BASE_URL=http://backend:8000/api/v1
# 브라우저에서 쓰는 구글 클라이언트 ID (실제 값 필요)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# HTTP(비TLS)로 포트 접근하면 false 여야 로그인 쿠키가 동작한다.
# 앞단에 도메인+HTTPS(리버스 프록시)를 둘 경우 true 로.
COOKIE_SECURE=false
