# 루트 .env 의 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 와 일치해야 한다.
# 기본값을 그대로 썼다면 아래 줄도 그대로 사용 가능.
DATABASE_URL=mysql+aiomysql://posefit:posefit@localhost:3306/posefit

# JWT access/refresh 토큰 서명 키 — 외부에서 받는 값이 아닌 서버가 자체 생성하는 비밀키.
# 아래 명령으로 생성한 뒤 붙여넣는다 (개발/운영 구분 없이 동일하게):
#   openssl rand -hex 32
JWT_SECRET_KEY=

# Google OAuth 2.0 클라이언트 — Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급.
# 승인된 리디렉션 URI 에 http://localhost:3000/auth/callback 을 추가해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
